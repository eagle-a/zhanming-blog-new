{
	"name": "zhanming-blog-new",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.4.0",
	"scripts": {
		"dev": "node scripts/run-local-next.mjs dev --turbopack -H 127.0.0.1 -p 2025",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env.local-postgres node_modules/drizzle-kit/bin.cjs migrate",
		"db:studio": "node --env-file=.env.local-postgres node_modules/drizzle-kit/bin.cjs studio",
		"admin:secrets": "node scripts/generate-admin-secrets.mjs",
		"agent:submit": "node --no-warnings --experimental-strip-types scripts/submit-ai-post.ts",
		"agent:smoke:local": "node --no-warnings --experimental-strip-types scripts/smoke-test-local-agent.mjs",
		"cms:smoke": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/smoke-test-cms.ts",
		"migrate:legacy": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/migrate-legacy-blogs.ts",
		"migrate:legacy:local": "node --env-file=.env.local-postgres --no-warnings --experimental-strip-types scripts/migrate-legacy-blogs.ts --local-assets --apply --confirm-environment=development",
		"migrate:content": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/migrate-site-content.ts",
		"svg": "node scripts/gen-svgs-index.js",
		"test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "next typegen && tsc --noEmit",
		"format:check": "prettier --check .github/workflows/ci.yml package.json PROJECT_AUDIT.md docs/PROJECT_OVERVIEW.md scripts/export-cms-backup.ts scripts/restore-cms-backup.ts scripts/reconcile-media.ts scripts/maintain-media.ts scripts/audit-public-assets.ts scripts/optimize-picture-assets.ts scripts/optimize-music-assets.ts scripts/lib/database.ts src/app/api/admin/media/upload/route.ts src/app/api/media/[...pathname]/route.ts src/app/blog/[id]/page.tsx src/app/layout.tsx src/app/robots.ts src/components/blog-sidebar.tsx src/components/published-blog-article.tsx src/components/music-card.tsx src/components/windows-platform-class.tsx src/db/schema.ts src/layout/head.tsx src/lib/content-repository.ts src/lib/csp-policy.ts src/lib/markdown-renderer.ts src/lib/media-dimensions.ts src/lib/media-lifecycle.ts src/lib/media-references.ts src/lib/posts-repository.ts src/lib/sanitize-html.ts src/lib/submissions-repository.ts src/proxy.ts tests/markdown-renderer.test.ts tests/media-lifecycle.test.ts tests/operations-hardening.test.ts",
		"db:check": "drizzle-kit check",
		"backup:cms": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/export-cms-backup.ts",
		"backup:restore": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/restore-cms-backup.ts",
		"media:reconcile": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/reconcile-media.ts",
		"media:maintain": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/maintain-media.ts",
		"assets:audit": "node --no-warnings --experimental-strip-types scripts/audit-public-assets.ts",
		"assets:optimize-pictures": "node --no-warnings --experimental-strip-types scripts/optimize-picture-assets.ts",
		"assets:optimize-music": "node --no-warnings --experimental-strip-types scripts/optimize-music-assets.ts",
		"check": "pnpm test && pnpm typecheck && pnpm format:check && pnpm db:check && pnpm build",
		"build": "next build"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.6.1",
		"@vercel/speed-insights": "^1.2.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.18",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.10.1",
		"html-react-parser": "^5.2.8",
		"katex": "^0.16.27",
		"lucide-react": "^0.553.0",
		"marked": "^17.0.0",
		"motion": "^12.23.24",
		"next": "16.3.0",
		"pg": "^8.22.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"sharp": "^0.35.3",
		"shiki": "^3.15.0",
		"sonner": "^2.0.7",
		"swr": "^2.3.6",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"twikoo": "^1.6.41",
		"zod": "^4.4.3",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@svgr/webpack": "^8.1.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/pg": "^8.20.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"tailwindcss": "^4",
		"typescript": "^5.9.3"
	}
}
