{
	"name": "zhanming-blog-new",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.4.0",
	"scripts": {
		"dev": "next dev --turbopack -p 2025",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
		"db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
		"admin:secrets": "node scripts/generate-admin-secrets.mjs",
		"cms:smoke": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/smoke-test-cms.ts",
		"migrate:legacy": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/migrate-legacy-blogs.ts",
		"migrate:content": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/migrate-site-content.ts",
		"svg": "node scripts/gen-svgs-index.js",
		"test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"build": "next build"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.6.1",
		"@vercel/speed-insights": "^1.2.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.18",
		"drizzle-orm": "^0.45.2",
		"html-react-parser": "^5.2.8",
		"katex": "^0.16.27",
		"lottie-web": "^5.13.0",
		"lucide-react": "^0.553.0",
		"marked": "^17.0.0",
		"motion": "^12.23.24",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"shiki": "^3.15.0",
		"sonner": "^2.0.7",
		"swr": "^2.3.6",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"ts-debounce": "^4.0.0",
		"twikoo": "^1.6.41",
		"zod": "^4.4.3",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@svgr/webpack": "^8.1.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"baseline-browser-mapping": "^2.11.12",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"tailwindcss": "^4",
		"typescript": "^5.9.3"
	}
}
